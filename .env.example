# RainCheck runs locally with no API keys.
# Weather comes from Open-Meteo (no key). Explanations use a fixed template.
# Set to 1 to ignore the on-disk weather cache and download again.
FORCE_REFRESH_WEATHER=0

# Optional. Leave blank to keep the template explanation.
# The older one-sentence rephrase still uses LLM_API_KEY. Default provider for that path is openai.
# LLM_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=
# LLM_API_URL=

# Optional assistant. Leave GEMINI_API_KEY blank to use the built-in answers.
# LLM_PROVIDER defaults to gemini for the assistant. LLM_MODEL overrides the model id.
# The key is read only on the server. Do not put it in frontend code or in git.
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# TRUSTED_PROXY_HEADER=x-forwarded-for
# LLM_DAILY_CAP_PER_IP=60
# LLM_DAILY_CAP=150

# Local Hardhat node. The oracle key below is Hardhat's published account #1.
# It only has coins on a fresh local node. Do not use it anywhere else.
RPC_URL=http://127.0.0.1:8545
ORACLE_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
DEPLOYMENT_PATH=backend/chain/deployment.json
